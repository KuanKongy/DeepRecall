OPENAI_API_KEY=sk-...
# Transcription key — an OpenRouter key by default (openrouter.ai → Keys).
# Any OpenAI-compatible transcription endpoint works via TRANSCRIBE_BASE_URL.
TRANSCRIBE_API_KEY=sk-or-...
TRANSCRIBE_BACKEND=api
SUMMARY_MODEL=gpt-4.1-nano
PORT=10000
# Optional overrides for the hosted transcription endpoint:
# TRANSCRIBE_BASE_URL=https://openrouter.ai/api/v1
# TRANSCRIBE_MODEL=openai/whisper-large-v3
# TRANSCRIBE_MAX_WORKERS=6
# Optional local-backend tuning: mlx cuts clips only inside silences at least
# this long; local (faster-whisper) CPU threads, 0 = CTranslate2 default.
# MLX_VAD_GAP_SECONDS=5
# LOCAL_CPU_THREADS=0
# Optional. Upstash gives a rediss:// TLS URL. Unset = in-process memory cache.
REDIS_URL=
# Optional. Appended to every cache key (":suffix") so a test or staging run
# can share the production Redis without touching its entries.
# REDIS_SUFFIX=
# Abuse limits (defaults shown; 0 disables a window). JOBS_* is the personal
# quota per browser (per device UUID; bare IP for header-less clients). Fully
# cached re-runs do not consume a slot. Summary regenerations are ~30x
# cheaper and get their own buckets, defaulting to 2x the analysis limits.
RATE_LIMIT_JOBS_PER_HOUR=6
RATE_LIMIT_JOBS_PER_DAY=12
RATE_LIMIT_SUMMARIES_PER_HOUR=12
RATE_LIMIT_SUMMARIES_PER_DAY=24
# Per-IP velocity guard: absolute burst per 10 minutes (doubled for
# summaries), then hour/day caps as multiples of the personal quota — loose
# enough that many users behind one campus NAT don't starve each other.
RATE_LIMIT_IP_BURST_10MIN=6
RATE_LIMIT_IP_HOUR_MULTIPLIER=4
RATE_LIMIT_IP_DAY_MULTIPLIER=8
# Global budget across ALL users — the wallet backstop no abuser can route
# around; the hourly slice keeps an attack from draining a day at once.
RATE_LIMIT_GLOBAL_ANALYSES_PER_HOUR=20
RATE_LIMIT_GLOBAL_ANALYSES_PER_DAY=100
RATE_LIMIT_GLOBAL_SUMMARIES_PER_HOUR=40
RATE_LIMIT_GLOBAL_SUMMARIES_PER_DAY=200
MAX_DURATION_SECONDS=10800
# Concurrent /media/by-url playback streams (each pins a gunicorn thread).
MEDIA_PROXY_STREAMS=3
# Comma-separated allowlist; * for local dev.
CORS_ORIGINS=https://kuankongy.github.io,https://namkhanhle.dev,http://namkhanhle.dev,http://localhost:8080
